generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String?
  preferredModes     String[] @default([])
  avoidMotorcycleRain Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  routeHistory RouteHistory[]

  @@map("profiles")
}

model WeatherCache {
  id               String   @id @default(cuid())
  lat              Float
  lng              Float
  intensity        String
  rainfallMmPerHour Float
  description      String
  source           String
  fetchedAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([lat, lng])
  @@index([expiresAt])
  @@map("weather_cache")
}

model TransitStop {
  id       String  @id
  name     String
  lat      Float
  lng      Float
  type     String
  parentId String?

  @@index([lat, lng])
  @@map("transit_stops")
}

model TransitRoute {
  id             String   @id
  shortName      String
  longName       String
  type           String
  stopIds        String[]
  fareMin        Int      @default(0)
  fareMax        Int      @default(0)
  fareNote       String   @default("")
  operatingHours String   @default("")
  frequency      Int      @default(15)
  color          String   @default("#888888")

  @@map("transit_routes")
}

model RouteHistory {
  id               String   @id @default(cuid())
  profileId        String?
  profile          Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  originLat        Float
  originLng        Float
  destinationLat   Float
  destinationLng   Float

  chosenMode       String
  weatherIntensity String
  discomfortScore  Float
  routeLabel       String

  // IEEE-standard research parameters (added 2026-05-15)
  trafficDelayIndex     Float?
  floodRiskZone         String?
  floodPenalty          Float?
  shelterCoveragePct    Int?
  walkingUnsheltered    Int?
  modeReliabilityIndex  Int?
  timeSacrificeRatio    Float?
  totalEtaMin           Int?
  totalCostIdr          Int?
  compositeScore        Float?

  createdAt        DateTime @default(now())

  @@index([profileId])
  @@index([createdAt])
  @@map("routes_history")
}

// One trip search from the app (anonymous). Both options are stored with
// their forecast rain per leg so they can be re-scored later on the rain
// that was actually observed (realised dose) — the paper's evaluation on
// real trips.
model PlanLog {
  id            String   @id @default(cuid())
  deviceId      String
  createdAt     DateTime @default(now())
  depart        DateTime
  beta          Float
  moto          String
  /// app price option at search time (Rp per perceived minute, 0 = off)
  vot           Float    @default(0)
  maxOjek       Float    @default(0)
  scenario      String
  originLat     Float
  originLng     Float
  destLat       Float
  destLng       Float
  rainSource    String
  rainIssuedAt  DateTime?
  networkVersion String
  offline       Boolean  @default(false)
  shift         Boolean
  fastest       Json?
  weatherAware  Json?

  // filled by /api/cron/realise after the trip window
  realisedAt           DateTime?
  realisedFastestDose  Float?
  realisedWeatherDose  Float?

  @@index([createdAt])
  @@index([deviceId])
  @@index([realisedAt])
  @@map("plan_log")
}

/// "Is it raining where you are?" answers from travellers during a trip:
/// ground truth to set against the forecast (and to catch what it missed)
model RainReport {
  id          String   @id @default(cuid())
  deviceId    String
  createdAt   DateTime @default(now())
  /// when it was asked (trip clock; a simulated trip can be in the future)
  at          DateTime
  /// rounded to ~100 m
  lat         Float
  lng         Float
  /// 0 dry · 3 light · 15 heavy (mm/h)
  mmh         Float
  /// what the forecast said for that place and minute
  forecastMmh Float
  /// mid (during the trip) or end (on arrival)
  moment      String
  scenario    String
  /// a simulated trip (demo clock) rather than a real one
  simulated   Boolean  @default(false)

  @@index([createdAt])
  @@map("rain_reports")
}
